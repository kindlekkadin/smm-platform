# PostgreSQL (used by apps/api via Prisma)
DATABASE_URL="postgresql://smm:smm@localhost:5433/smm?schema=public"

# Redis (used by apps/api for BullMQ background jobs, later phases)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production"

# API server
PORT=3001

# Origin allowed to make credentialed requests to the API (the Next.js web app)
WEB_ORIGIN="http://localhost:3000"

# Social account token encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Local-dev-only key management — see apps/api/src/common/crypto/token-cipher.service.ts
SOCIAL_TOKEN_ENCRYPTION_KEY="replace-with-generated-32-byte-base64-key"
