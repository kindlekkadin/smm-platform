// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  CREATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  displayName   String
  role          UserRole
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  socialAccounts SocialAccount[]
  orders        Order[]
  payments      Payment[]
  walletTransactions WalletTransaction[]
  creatorProfile CreatorProfile?
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  X
  DEV_MOCK
}

enum SocialAccountStatus {
  ACTIVE
  DISCONNECTED
}

model SocialAccount {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          SocialPlatform
  platformAccountId String
  username          String
  displayName       String?
  profileImageUrl   String?
  status            SocialAccountStatus @default(ACTIVE)
  // Encrypted at rest (AES-256-GCM, see TokenCipherService). Never returned by any API response.
  accessTokenSecret String?
  connectedAt       DateTime            @default(now())
  disconnectedAt    DateTime?
  updatedAt         DateTime            @updatedAt
  orders            Order[]

  @@unique([userId, platform, platformAccountId])
  @@index([userId])
}

enum ServiceCategory {
  FOLLOWERS
  LIKES
  VIEWS
  COMMENTS
  ENGAGEMENT
  // Organic, human-fulfilled packages sold through the creator marketplace —
  // see PricingModel.FLAT below. Never fulfilled by a bot/automation provider.
  UGC_CONTENT
  SHOUTOUT
  AD_CAMPAIGN
  OTHER
}

// How a Service (and, mirrored, a CreatorOffering/Order/OrderAssignment) is
// priced. PER_THOUSAND is the original linear-scale model. FLAT is a fixed
// package price (e.g. "one UGC video", "one sponsored post") where scaling by
// quantity means "N packages", not "N units per thousand".
enum PricingModel {
  PER_THOUSAND
  FLAT
}

model Service {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  description String
  category    ServiceCategory
  platform    SocialPlatform

  pricingModel PricingModel @default(PER_THOUSAND)

  // Price per 1,000 units. Decimal (not float) to avoid floating-point rounding
  // errors in money — this is what later phases' orders/pricing engine will read.
  // Required when pricingModel is PER_THOUSAND, null when FLAT.
  pricePerThousand Decimal? @db.Decimal(10, 2)
  // Fixed price per package. Required when pricingModel is FLAT, null when
  // PER_THOUSAND. Enforced in the DTO/service layer, not a DB constraint.
  flatPrice        Decimal? @db.Decimal(10, 2)
  minQuantity      Int
  maxQuantity      Int

  // Admin-set, human-readable turnaround estimate (e.g. "1-3 hours",
  // "3-5 days"). Purely informational — never fabricated by the app itself,
  // and null means "no estimate given" rather than implying a number.
  estimatedDelivery String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  creatorOfferings CreatorOffering[]
  providerMappings ProviderServiceMapping[]

  @@index([platform])
  @@index([category])
  @@index([active])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

model Order {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])

  // Optional targeting info (e.g. a specific post URL) beyond "this connected account".
  targetIdentifier String?

  quantity Int

  // Pricing snapshot at order-creation time — frozen so later Service price
  // changes never alter an existing order's price. Never recompute a
  // historical order's total from the live Service record. Mirrors
  // Service's own pricingModel/pricePerThousand/flatPrice shape: exactly one
  // of unitPricePerThousand/unitFlatPrice is set, matching pricingModel.
  pricingModel         PricingModel @default(PER_THOUSAND)
  unitPricePerThousand Decimal?     @db.Decimal(10, 2)
  unitFlatPrice        Decimal?     @db.Decimal(10, 2)
  totalPrice           Decimal      @db.Decimal(10, 2)

  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  payments  Payment[]
  assignments OrderAssignment[]
  providerSubmissions ProviderOrderSubmission[]

  @@index([userId])
  @@index([status])
  // Analytics filters by date range and by service, and virtually every
  // admin listing sorts by createdAt — neither was indexed.
  @@index([createdAt])
  @@index([serviceId])
}

// Only DEV_MOCK is implemented — no real provider has been selected yet and
// no credentials exist in this environment. See payments/PAYMENT_PROVIDER_INTEGRATION.md
// for what a real provider (Stripe/PayMongo/Xendit/etc.) requires to be added.
// PAYMONGO is only actually usable once PAYMONGO_SECRET_KEY and
// PAYMONGO_WEBHOOK_SECRET are configured — see PAYMENT_PROVIDER_INTEGRATION.md.
// Until then PaymentsModule never registers it and DEV_MOCK remains the only
// active provider, exactly like every other "real" integration in this app.
enum PaymentProvider {
  DEV_MOCK
  PAYMONGO
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// What a Payment is actually for. A wallet top-up has no Order to confirm —
// it credits a WalletTransaction instead. Kept as an explicit field rather
// than inferred from orderId being null, so the branch in the webhook
// handler can't silently do the wrong thing if that ever changes.
enum PaymentPurpose {
  ORDER_PAYMENT
  WALLET_TOP_UP
}

model Payment {
  id      String  @id @default(uuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose PaymentPurpose @default(ORDER_PAYMENT)

  provider    PaymentProvider
  // Opaque reference from the provider (session/intent id). For DEV_MOCK this
  // is an unguessable generated id, not a real payment identifier.
  providerRef String          @unique

  // Snapshot of order.totalPrice (ORDER_PAYMENT) or the customer-entered
  // top-up amount (WALLET_TOP_UP) at payment-initiation time — never derived
  // from a client-supplied amount at webhook time.
  amount Decimal @db.Decimal(10, 2)

  status        PaymentStatus @default(PENDING)
  failureReason String?
  refundReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walletTransaction WalletTransaction?

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

// Ledger, not a mutable counter — balance is always SUM(amount) for a user,
// mirroring how CreatorEarning/PayoutRequest already compute creator
// balance in this codebase. Only TOP_UP exists today: adding funds is live,
// but nothing spends from this balance yet (orders are still paid
// individually) — see the Add Funds page copy for the honest disclosure.
enum WalletTransactionType {
  TOP_UP
}

model WalletTransaction {
  id     String                @id @default(uuid())
  userId String
  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   WalletTransactionType
  amount Decimal               @db.Decimal(10, 2)

  // The Payment that produced this credit. One-to-one and unique so a
  // replayed webhook can never double-credit — the DB itself rejects it,
  // on top of PaymentsService's own PENDING-status idempotency guard.
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
}

// ---- Phase 6: Creator Marketplace ----
// Schema only in this step — no controllers/services/business logic yet.

enum CreatorVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model CreatorProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio String?

  verificationStatus CreatorVerificationStatus @default(PENDING)
  appliedAt           DateTime                 @default(now())
  reviewedAt          DateTime?
  reviewedByAdminId   String?
  rejectionReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings      CreatorOffering[]
  assignments    OrderAssignment[]
  earnings       CreatorEarning[]
  payoutRequests PayoutRequest[]
}

enum CreatorOfferingStatus {
  PENDING
  APPROVED
  REJECTED
}

model CreatorOffering {
  id               String         @id @default(uuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  serviceId        String
  service          Service        @relation(fields: [serviceId], references: [id])

  // Always copied from the parent Service at creation time, never
  // independently chosen — an offering can't quote a per-thousand rate for a
  // flat-priced package or vice versa.
  pricingModel PricingModel @default(PER_THOUSAND)

  // Creator's own quoted rate — independent of Service.pricePerThousand.
  // Required when pricingModel is PER_THOUSAND, null when FLAT.
  creatorPricePerThousand Decimal? @db.Decimal(10, 2)
  // Creator's own quoted flat package price. Required when pricingModel is
  // FLAT, null when PER_THOUSAND.
  creatorFlatPrice        Decimal? @db.Decimal(10, 2)
  minQuantity             Int
  maxQuantity             Int
  notes                   String?

  status CreatorOfferingStatus @default(PENDING)
  active Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments OrderAssignment[]

  @@unique([creatorProfileId, serviceId])
  @@index([serviceId])
  @@index([status])
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  COMPLETED
  REJECTED
  CANCELLED
}

model OrderAssignment {
  id                String          @id @default(uuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id])
  creatorProfileId  String
  creatorProfile    CreatorProfile  @relation(fields: [creatorProfileId], references: [id])
  creatorOfferingId String
  creatorOffering   CreatorOffering @relation(fields: [creatorOfferingId], references: [id])

  // Snapshot of CreatorOffering.pricingModel/creatorPricePerThousand/
  // creatorFlatPrice at assignment time — frozen so a later CreatorOffering
  // price change never alters an in-flight or historical assignment/earning.
  // Combined with Order.quantity this is the sole input to CreatorEarning.amount.
  pricingModel            PricingModel @default(PER_THOUSAND)
  creatorPricePerThousand Decimal?     @db.Decimal(10, 2)
  creatorFlatPrice        Decimal?     @db.Decimal(10, 2)

  status      AssignmentStatus @default(OFFERED)
  assignedAt  DateTime         @default(now())
  respondedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  rejectionReason    String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  earning CreatorEarning?

  @@index([orderId])
  @@index([creatorProfileId])
  @@index([creatorOfferingId])
  @@index([status])
}

model CreatorEarning {
  id                String          @id @default(uuid())
  creatorProfileId  String
  creatorProfile    CreatorProfile  @relation(fields: [creatorProfileId], references: [id])
  orderAssignmentId String          @unique
  orderAssignment   OrderAssignment @relation(fields: [orderAssignmentId], references: [id])

  // Immutable — computed once, at assignment completion, from the frozen
  // OrderAssignment.creatorPricePerThousand. Never recalculated afterward.
  amount Decimal @db.Decimal(10, 2)

  payoutRequestId String?
  payoutRequest   PayoutRequest? @relation(fields: [payoutRequestId], references: [id])

  createdAt DateTime @default(now())

  @@index([creatorProfileId])
  @@index([payoutRequestId])
}

enum PayoutRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model PayoutRequest {
  id               String         @id @default(uuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])

  // Sum of the CreatorEarning rows it covers, fixed at request time.
  amount Decimal @db.Decimal(10, 2)

  status      PayoutRequestStatus @default(PENDING)
  requestedAt DateTime            @default(now())
  reviewedAt  DateTime?
  paidAt      DateTime?

  rejectionReason String?
  adminNotes      String?

  earnings CreatorEarning[]

  @@index([creatorProfileId])
  @@index([status])
}

// ---- Phase 7: Provider / Fulfillment abstraction ----
//
// A second, independent fulfillment channel alongside Phase 6's creator
// assignments — Order's customer-facing lifecycle (OrderStatus) is
// unchanged. Only DEV_MOCK is implemented; no real automated fulfillment
// API exists or is contacted. The mock provider never auto-reports
// completion — see providers/dev-mock.provider.ts.

enum ProviderStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model Provider {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  apiEndpoint String?
  // Encrypted at rest (AES-256-GCM, see TokenCipherService). Never returned by any API response.
  apiKeySecret String?
  isActive    Boolean  @default(true)
  status      ProviderStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceMappings ProviderServiceMapping[]
  submissions     ProviderOrderSubmission[]
}

model ProviderServiceMapping {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])

  providerServiceId String

  // Optional cost/quantity rules for this provider+service pairing. Distinct
  // from Service.pricePerThousand (what the customer pays) and
  // CreatorOffering.creatorPricePerThousand (what a human creator earns).
  providerPricePerThousand Decimal? @db.Decimal(10, 2)
  minQuantity              Int?
  maxQuantity              Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions ProviderOrderSubmission[]

  @@unique([providerId, serviceId])
  @@index([serviceId])
}

enum ProviderSubmissionStatus {
  PENDING
  SUBMITTED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

model ProviderOrderSubmission {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])

  providerServiceMappingId String
  providerServiceMapping   ProviderServiceMapping @relation(fields: [providerServiceMappingId], references: [id])

  // External order reference once submitted — unguessable, from the provider.
  providerOrderRef String? @unique
  // Raw status string as last reported by the provider (for display/audit).
  externalStatus   String?
  status           ProviderSubmissionStatus @default(PENDING)

  // Snapshot of providerServiceMapping.providerPricePerThousand * order.quantity
  // / 1000, frozen at dispatch time — mirrors CreatorEarning's frozen-price
  // pattern. Null if the mapping had no providerPricePerThousand configured
  // (cost unknown). Never recomputed on retry.
  cost Decimal? @db.Decimal(10, 2)

  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  // Most recent raw request/response payload, for audit/debugging.
  responseLog   Json?

  submittedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([providerId])
  @@index([status])
}
